{
  "App": {
    "Mode": "Training",
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ],
    "RateLimits": {
      "Read": {
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Write": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
